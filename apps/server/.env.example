# Copy to `.env` and fill in real values for local development.
NODE_ENV=development
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
WEB_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
ADMIN_EMAIL=admin@example.com
DATABASE_URL=postgresql://postgres:password@localhost:5432/tcl-guide

# Neon Object Storage — refresh with: neon env pull --file apps/server/.env
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_BUCKET_NAME=tcl-guide-images
